{
  "name": "craftedbyteja",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo — craftedbyteja.com (root site, dilse, tools, PFT, CMS).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev":       "npm run dev --workspace apps/pft",
    "dev:pft":   "npm run dev --workspace apps/pft",
    "dev:root":  "npm run dev --workspace apps/root",
    "dev:tools": "npm run dev --workspace apps/tools",
    "dev:dilse": "npm run dev --workspace apps/dilse",
    "dev:cms":   "npm run dev --workspace apps/cms",
    "dev:games": "npm run dev --workspace apps/games",
    "build:pft": "npm run build --workspace apps/pft",
    "lint:pft":  "npm run lint --workspace apps/pft"
  }
}
